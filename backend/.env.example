# Bu dosyayı .env olarak kopyala ve gerçek değerleri gir.
# .env asla commit edilmez (bkz. .gitignore).

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cae_dev

# CalculiX çözücü. Boşsa PATH ve backend/vendor/ccx/ bakılır.
# Windows (conda-forge): vendor/ccx-env/Library/bin/ccx.exe
# CCX_PATH=vendor/ccx-env/Library/bin/ccx.exe

# OpenRadioss kök dizini (resmi değişken). Dosya verilirse engine ikilisi kabul edilir.
# Codespace imajı: /opt/openradioss  Windows: vendor/openradioss (OpenRadioss_win64.zip aç).
# OPENRADIOSS_PATH=/opt/openradioss

# --- WeWeb / API anahtarı -------------------------------------------------
# Kimlik: her isteğe `Authorization: Bearer <anahtar>`. Anahtar üretmek:
#   python scripts/create_api_key.py "Ad"
# AUTH_REQUIRED=1 → anahtarsız istek 401 (/health hariç). Varsayılan 0:
# başlık yoksa anonim devam, başlık varsa yine doğrulanır.
# AUTH_REQUIRED=1
# WeWeb alan adı (virgülle birden çok). Boşsa "*" (yalnız geliştirme).
# CORS_ALLOW_ORIGINS=https://xxxx.weweb-preview.io,https://app.alanadi.com
