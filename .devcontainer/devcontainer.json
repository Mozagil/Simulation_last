{
  "name": "Simulation_last",

  // Hazır image yerine kendi Dockerfile'ımız: sistem bağımlılıkları
  // (CalculiX, gmsh'in libGLU vb. kütüphaneleri) image katmanına gömülür ve
  // önbelleklenir. Eskiden bunlar postCreateCommand'daydı ve tek bir apt
  // hatası hepsini birden atlıyordu.
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // Taban image ince (python:3.12); Node, gh ve Docker buradan geliyor.
  // docker-in-docker: Postgres `docker compose` ile ayağa kalkıyor.
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  // Proje bağımlılıkları image'a gömülemez (çalışma alanı ancak container
  // oluşturulduktan sonra bağlanır), bu yüzden burada kuruluyor.
  // `|| true` YOK: bir kurulum patlarsa sessizce devam etmek yerine
  // Codespace kurulum log'unda görünsün.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Her başlatmada (ilk açılış + stop/restart) çalışır: .env dosyalarını
  // üretir, Postgres/backend/frontend'i ayağa kaldırır, 5173 ve 8000'i
  // public yapar. Elle terminal açıp sunucu başlatma adımı kalkar.
  "postStartCommand": "bash .devcontainer/start.sh",

  // `forwardPorts` BİLEREK YOK. Önceden kayıtlı port girişleri Codespace
  // uyku/uyanma döngüsünde bayatlıyor ve proxy boş 404 veriyordu
  // (PORTS panelinde "Aktiver Prozess" boş kalıyordu). Portlar artık
  // süreç dinlemeye başlayınca otomatik yakalanıyor; etiketler yine burada.
  "portsAttributes": {
    "8000": { "label": "Backend (FastAPI)", "onAutoForward": "silent" },
    "5173": { "label": "Frontend (Vite)", "onAutoForward": "silent" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  }
}
